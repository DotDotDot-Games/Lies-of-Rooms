; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lies of Rooms"
run/main_scene="uid://dkmdqlijb4fe8"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameDebugger="*uid://xodsxgpsskk2"
ComponentManager="*uid://dhg8bupj1ups7"
TransitionManager="*uid://cno4wejckrna6"
ScenesManager="*uid://qqccb5c6n424"
UIManager="*uid://dby5u3bvyp14j"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/int_as_enum_without_match=2

[display]

window/size/viewport_width=424
window/size/viewport_height=240
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="GDSharpProjects Template"

[editor_plugins]

enabled=PackedStringArray("res://addons/drag_and_drop/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/log/plugin.cfg")

[gui]

theme/custom="uid://bgmhranoxbe6o"
theme/custom_font="uid://c3862txwlnl20"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Entities"
2d_physics/layer_3="Interactions"
2d_physics/layer_4="Players"
2d_physics/layer_5="VisionBlockers"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

